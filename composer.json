{
    "name": "arghavan/visual-script",
    "description": "پکیج اسکریپت‌نویسی ویژوال (Node-based) برای لاراول - ساخت منطق برنامه با المان‌های بصری (کوئری، شرط، حلقه، متغیر) بدون نوشتن PHP خام",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "symfony/expression-language": "^6.0|^7.0"
    },
    "autoload": {
        "psr-4": {
            "VisualScript\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VisualScript\\VisualScriptServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
